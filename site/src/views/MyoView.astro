---
import { catalog } from '../lib/catalog';
import { t, type MessageKey } from '../i18n';
import { localePath, type Lang } from '../lib/routes';
const { lang } = Astro.props as { lang: Lang };

const steps = [
  {
    n: 1,
    title: { en: 'Find the audio', fr: 'Trouver l’audio' },
    body: {
      en: 'Pick a podcast feed, a YouTube playlist or an audiobook folder. Prefer sources you own or that are free to download.',
      fr: 'Choisissez un flux de podcast, une playlist YouTube ou un dossier de livres audio. Privilégiez ce que vous possédez ou ce qui est libre.',
    },
    tools: ['podcast-catalogue', 'louis', 'yoto-book-maker'],
  },
  {
    n: 2,
    title: { en: 'Split and normalize', fr: 'Découper et normaliser' },
    body: {
      en: 'Export MP3 mono at 44.1 kHz. One chapter per track, under one hour. Name tracks with a two-digit prefix so the order survives.',
      fr: 'Exportez en MP3 mono à 44,1 kHz. Un chapitre par piste, moins d’une heure. Préfixez les pistes avec deux chiffres pour garder l’ordre.',
    },
    tools: ['yoto-card-kit', 'yoto-music'],
  },
  {
    n: 3,
    title: { en: 'Choose the icon', fr: 'Choisir l’icône' },
    body: {
      en: 'A 16x16 PNG. Keep it readable at a glance and avoid pure black, which disappears on the player background.',
      fr: 'Un PNG 16x16. Veillez à rester lisible au premier coup d’œil et évitez le noir pur, invisible sur le fond du lecteur.',
    },
    tools: ['icons-catalogue', 'yotoicons', 'yotopixels'],
  },
  {
    n: 4,
    title: { en: 'Create the cover', fr: 'Créer la jaquette' },
    body: {
      en: 'The cover is the artwork shown in the app and on the player. Export 638 × 1011 px portrait — the card ratio — as JPEG or PNG, and keep the title about 40 px from the edges. The same image can serve as the printed label.',
      fr: 'La jaquette (cover) est l’image affichée dans l’app et sur le lecteur. Exportez en 638 × 1011 px portrait — le ratio de la carte — en JPEG ou PNG, et gardez le titre à environ 40 px des bords. La même image peut servir pour le label imprimé.',
    },
    tools: ['myo-studio', 'yoto-card-kit', 'yoto-up'],
  },
  {
    n: 5,
    title: { en: 'Create the card', fr: 'Créer la carte' },
    body: {
      en: 'Upload the tracks and the icon in the Yoto app, or use a MYO tool. Link a blank NFC card when the physical card matters.',
      fr: 'Envoyez les pistes et l’icône dans l’app Yoto, ou utilisez un outil MYO. Associez une carte NFC vierge si la carte physique compte.',
    },
    tools: ['yoto-app', 'yoto-manager', 'custom-yoto-cards'],
  },
  {
    n: 6,
    title: { en: 'Print the label', fr: 'Imprimer le label' },
    body: {
      en: 'Print a label with the same cover art and the child’s name. Laminate it or use a sticker sheet so it survives small hands.',
      fr: 'Imprimez un label avec la même jaquette et le prénom de l’enfant. Plastifiez-le ou utilisez une planche d’autocollants.',
    },
    tools: ['selphyoto', 'yotolabels'],
  },
] as const;

const optionalSteps = new Set([2, 6]);

const bySlug = new Map(catalog.projects.map((project) => [project.slug, project]));
---

<section class="container page">
  <p class="eyebrow">Guide</p>
  <h1>{lang === 'fr' ? 'Créer sa première carte MYO' : 'Build your first MYO card'}</h1>
  <p class="lede">
    {
      lang === 'fr'
        ? 'Six étapes, du fichier audio brut au label imprimé — dont deux optionnelles. Chaque étape indique un outil recommandé et une alternative.'
        : 'Six steps, from a raw audio file to a printed label — two of them optional. Each step names one recommended tool and an alternative.'
    }
  </p>
  <ol class="steps">
    {
      steps.map((step) => (
        <li id={`step-${step.n}`}>
          <span class="num" aria-hidden="true">
            {step.n}
          </span>
          <div>
            <h2>
              <span class="sr-only">
                {lang === 'fr'
                  ? `Étape ${step.n}${optionalSteps.has(step.n) ? ' (optionnelle)' : ''} : `
                  : `Step ${step.n}${optionalSteps.has(step.n) ? ' (optional)' : ''}: `}
              </span>
              {step.title[lang]}
              {optionalSteps.has(step.n) && (
                <span class="badge" aria-hidden="true">{lang === 'fr' ? 'Optionnelle' : 'Optional'}</span>
              )}
            </h2>
            <p>{step.body[lang]}</p>
            <ul class="tools">
              {step.tools.map((slug, index) => {
                const project = bySlug.get(slug);
                if (!project) {
                  throw new Error(
                    `MyoView: step ${step.n} references "${slug}", which is missing from the catalog.`,
                  );
                }
                return (
                  <li>
                    <a href={localePath(lang, `/p/${project.slug}/`)}>{project.name}</a>
                    <span>
                      {index === 0
                        ? lang === 'fr'
                          ? 'Recommandé'
                          : 'Recommended'
                        : lang === 'fr'
                          ? 'Alternative'
                          : 'Alternative'}
                      {project.status !== 'active'
                        ? ` · ${t(lang, `status.${project.status}` as MessageKey)}`
                        : ''}
                    </span>
                  </li>
                );
              })}
            </ul>
            {step.n === 3 && (
              <p class="step-cta">
                <a class="btn" href={localePath(lang, '/editor/')}>
                  {lang === 'fr' ? 'Créer mon icône 16 × 16' : 'Create my 16 × 16 icon'}
                </a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  <p class="tip">
    {
      lang === 'fr'
        ? 'Un doute sur un format ? La fiche de chaque outil indique sa plateforme et, quand elles sont connues, ses prérequis et la date de son dernier commit.'
        : 'Unsure about a format? Each tool page lists its platform and, where known, its requirements and last commit.'
    }
  </p>
  <a href={localePath(lang, '/projects/')}
    >{lang === 'fr' ? 'Voir tous les outils' : 'See all tools'} →</a
  >
  <a class="chooser-link" href={localePath(lang, '/chooser/')}
    >{lang === 'fr' ? 'Trouver l’outil qui me convient' : 'Find the right tool for me'} →</a
  >
</section>

<style>
  .page {
    padding-block: var(--space-8);
    max-width: 900px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--accent);
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.15rem;
    max-width: 62ch;
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-8);
  }
  .steps > li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    box-shadow: var(--shadow);
  }
  .num {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-weight: 800;
  }
  h2 {
    margin-bottom: var(--space-2);
    font-size: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
  }
  .tools li {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .tools span {
    color: var(--ink-muted);
    font-weight: 600;
  }
  .tip {
    color: var(--ink-muted);
  }
  .step-cta {
    margin: var(--space-4) 0 0;
  }
  .btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-weight: 800;
    color: var(--bg);
    background: var(--accent);
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
  .btn:hover {
    background: var(--accent-strong);
  }
  .chooser-link {
    margin-inline-start: var(--space-4);
    font-weight: 800;
  }
  .steps > li[id^='step-'] {
    scroll-margin-top: 5.5rem;
  }
</style>
