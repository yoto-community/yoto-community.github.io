---
import { catalog } from '../lib/catalog';
import { changelog } from '../lib/changelog';
import { t, type MessageKey } from '../i18n';
import { localePath, type Lang } from '../lib/routes';
import { REPO_URL } from '../lib/site';
import type { ChangelogEntry } from '../../../scripts/lib/types';

const { lang } = Astro.props as { lang: Lang };
const projectNames = new Map(catalog.projects.map((project) => [project.slug, project.name]));
const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';
const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });
const dayFormatter = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const groups = new Map<string, { label: string; entries: ChangelogEntry[] }>();
for (const entry of changelog.entries) {
  const key = entry.date.slice(0, 7);
  const group = groups.get(key) ?? {
    label: monthFormatter.format(new Date(entry.date)),
    entries: [],
  };
  group.entries.push(entry);
  groups.set(key, group);
}

const isCommit = (id: string) => /^[0-9a-f]{7,40}$/i.test(id);
---

<section class="container page">
  <h1>{t(lang, 'changelog.title')}</h1>
  <p class="lede">{t(lang, 'changelog.lede')}</p>
  <p class="feeds">
    <a href="/feed.xml">{t(lang, 'changelog.feed')}</a>
    <span aria-hidden="true">·</span>
    <a href="/feed.json">{t(lang, 'changelog.jsonFeed')}</a>
  </p>

  {changelog.entries.length === 0 && <p class="empty">{t(lang, 'changelog.empty')}</p>}

  {
    [...groups.entries()].map(([key, group]) => (
      <section class="month" aria-labelledby={`month-${key}`}>
        <h2 id={`month-${key}`}>{group.label}</h2>
        <ol class="entries">
          {group.entries.map((entry) => (
            <li id={entry.id}>
              <div class="entry-head">
                <h3>{entry.title}</h3>
                <time datetime={entry.date}>{dayFormatter.format(new Date(entry.date))}</time>
              </div>
              {entry.projects.length > 8 ? (
                <details>
                  <summary>
                    {entry.projects.length} {t(lang, 'changelog.projects')}
                  </summary>
                  <ul class="projects">
                    {entry.projects.map((slug) => {
                      const projectName = projectNames.get(slug);
                      if (!projectName) return null;
                      return (
                        <li>
                          <a href={localePath(lang, `/p/${slug}/`)}>{projectName}</a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              ) : entry.projects.length > 0 ? (
                <ul class="projects">
                  {entry.projects.map((slug) => {
                      const projectName = projectNames.get(slug);
                      if (!projectName) return null;
                      return (
                        <li>
                          <a href={localePath(lang, `/p/${slug}/`)}>{projectName}</a>
                        </li>
                      );
                    })}
                </ul>
              ) : null}
              {entry.areas.length > 0 && (
                <p class="areas">
                  {t(lang, 'changelog.areas')}:{' '}
                  {entry.areas
                    .map((area) => t(lang, `changelog.area.${area}` as MessageKey))
                    .join(', ')}
                </p>
              )}
              {isCommit(entry.id) && (
                <a class="commit" href={`${REPO_URL}/commit/${entry.id}`}>
                  {t(lang, 'changelog.commit')} →
                </a>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</section>

<style>
  .page {
    padding-block: var(--space-8);
    max-width: 820px;
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.1rem;
    max-width: 62ch;
  }
  .feeds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: 700;
  }
  .month {
    margin-top: var(--space-8);
  }
  .entries {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .entries > li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow);
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .entry-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .entry-head time {
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
  }
  .projects a {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
  }
  .projects a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }
  details summary {
    cursor: pointer;
    margin-top: var(--space-3);
    color: var(--ink-muted);
    font-weight: 700;
  }
  .areas {
    margin: var(--space-3) 0 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .commit {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 800;
    font-size: 0.9rem;
  }
  .empty {
    color: var(--ink-muted);
  }
</style>
