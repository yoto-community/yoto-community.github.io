---
import StatusBadge from '../components/StatusBadge.astro';
import { t, type MessageKey } from '../i18n';
import { localePath, type Lang } from '../lib/routes';
import { catalog } from '../lib/catalog';
import { editProjectUrl, translateProjectUrl } from '../lib/contribute-links';
import { humanizeList } from '../lib/format';
import { projectActions } from '../lib/project-actions';
import { absoluteUrl } from '../lib/site';
import { projectJsonLd, jsonLdScript } from '../lib/jsonld';
import type { Project } from '../../../scripts/lib/types';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const description =
  lang === 'fr' && project.descriptionFr ? project.descriptionFr : project.description;
const fallback = lang === 'fr' && !project.descriptionFr;
const category = catalog.categories.find((item) => item.slug === project.category);
const related = catalog.projects
  .filter(
    (item) =>
      item.slug !== project.slug &&
      item.category === project.category &&
      item.tags.some((tag) => project.tags.includes(tag)),
  )
  .sort(
    (a, b) =>
      b.tags.filter((tag) => project.tags.includes(tag)).length -
      a.tags.filter((tag) => project.tags.includes(tag)).length,
  )
  .slice(0, 3);
const describe = (item: Project) =>
  lang === 'fr' && item.descriptionFr ? item.descriptionFr : item.description;
const needsEnglish = (item: Project) => lang === 'fr' && !item.descriptionFr;
const warningKey = project.warning ? (`project.warning.${project.warning}` as MessageKey) : null;
const projectsHref = localePath(lang, '/projects/');
const actions = projectActions(project);
const repo = project.repo;
const authorGithubUrl = project.authorGithub ? `https://github.com/${project.authorGithub}` : null;
const loadingReadme = t(lang, 'project.loadingReadme');
const readmeError = t(lang, 'project.readmeError');
const readmeUnavailable = t(lang, 'project.readmeUnavailable');
---

<article class="container detail" data-repo={repo ?? ''}>
  <nav class="crumbs" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
    <a href={projectsHref}>{t(lang, 'nav.projects')}</a>
    <span aria-hidden="true">/</span>
    <a href={localePath(lang, `/categories/${project.category}/`)}>
      {category?.label[lang] ?? project.category}
    </a>
  </nav>
  <header>
    <div class="title">
      <h1>{project.name}</h1>
      <script
        type="application/ld+json"
        set:html={jsonLdScript(
          projectJsonLd(project, absoluteUrl(lang, `/p/${project.slug}/`), description),
        )}
      />
      <StatusBadge status={project.status} lang={lang} />
    </div>
    <p class="lede">
      {description}{fallback && <span class="en" title={t(lang, 'project.englishOnly')}>EN</span>}
    </p>
    {
      fallback && (
        <p class="untranslated">
          {t(lang, 'project.untranslated')}{' '}
          <a
            href={translateProjectUrl(project.slug, project.name)}
            rel="noopener"
            target="_blank"
          >
            {t(lang, 'project.translate')}
          </a>
        </p>
      )
    }
    <div class="actions">
      {
        actions.showWebsite && (
          <a class="btn primary" href={project.url} rel="noopener" target="_blank">
            {t(lang, 'project.website')}
          </a>
        )
      }
      {
        actions.showRepo && repo && (
          <a
            class:list={['btn', actions.primary === 'repo' ? 'primary' : 'ghost']}
            href={repo}
            rel="noopener"
            target="_blank"
          >
            {t(lang, 'project.repo')}
          </a>
        )
      }
    </div>
  </header>
  {warningKey && <p class="warning">{t(lang, warningKey)}</p>}
  <dl class="meta">
    <div>
    <dt>{t(lang, 'project.author')}</dt>
    <dd>
      {authorGithubUrl ? (
        <a href={authorGithubUrl} rel="noopener" target="_blank">
          {project.author}
        </a>
      ) : (
        project.author
      )}
    </dd>
  </div>
    <div><dt>{t(lang, 'project.license')}</dt><dd>{project.license}</dd></div>
    <div>
      <dt>{t(lang, 'project.platforms')}</dt>
      <dd>{humanizeList(project.platforms)}</dd>
    </div>
    {
      project.requires?.length ? (
        <div>
          <dt>{t(lang, 'project.requires')}</dt>
          <dd>{humanizeList(project.requires)}</dd>
        </div>
      ) : null
    }
    {
      project.meta?.lastCommit ? (
        <div>
          <dt>{t(lang, 'project.lastCommit')}</dt>
          <dd>{project.meta.lastCommit}</dd>
        </div>
      ) : null
    }
    {
      project.meta?.stars !== undefined ? (
        <div>
          <dt>{t(lang, 'project.stars')}</dt>
          <dd>★ {project.meta.stars}</dd>
        </div>
      ) : null
    }
  </dl>
  <ul class="tags" aria-label={t(lang, 'filter.tag')}>
    {
      project.tags.map((tag) => (
        <li>
          <a href={`${projectsHref}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        </li>
      ))
    }
  </ul>
  {
    project.status === 'deprecated' && project.deprecatedBy && (
      <p class="replaced">
        {lang === 'fr'
          ? `Remplacé par : ${project.deprecatedBy}`
          : `Replaced by ${project.deprecatedBy}`}
      </p>
    )
  }
  {
    project.repo && (
      <details>
        <summary>{t(lang, 'project.moreDetails')}</summary>
        <div class="readme-preview-detail" data-loading={loadingReadme} data-error={readmeError} data-unavailable={readmeUnavailable}>
          <p>{loadingReadme}</p>
        </div>
      </details>
    )
  }
  {
    related.length > 0 && (
      <section aria-labelledby="related" data-pagefind-ignore>
        <h2 id="related">{t(lang, 'project.related')}</h2>
        <ul class="related">
          {related.map((item) => (
            <li>
              <a href={localePath(lang, `/p/${item.slug}/`)}>{item.name}</a>
              <span class="desc">
                {describe(item)}{needsEnglish(item) && (
                  <span class="en" title={t(lang, 'project.englishOnly')}>EN</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <p class="improve" data-pagefind-ignore>
    <a href={editProjectUrl(project.slug)} rel="noopener" target="_blank">
      {t(lang, 'project.edit')}
    </a>
  </p>
</article>

<script>
  import { marked, type Tokens } from 'marked';

  const BRANCHES = ['main', 'master'];
  const FILES = ['README.md', 'readme.md', 'Readme.md', 'README.MD', 'README'];

  const escapeHtml = (text: string) =>
    String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  const isAbsolute = (href: string) =>
    /^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(href) || href.startsWith('#');

  function buildRenderer(owner: string, name: string, branch: string) {
    const renderer = new marked.Renderer();
    // Échappe le HTML brut du README pour éviter l'injection de balises.
    renderer.html = ({ text }: Tokens.HTML | Tokens.Tag) => escapeHtml(text);
    // Résout les images relatives vers le dépôt (raw.githubusercontent.com).
    renderer.image = ({ href, title, text }: Tokens.Image) => {
      const src = isAbsolute(href)
        ? href
        : `https://raw.githubusercontent.com/${owner}/${name}/refs/heads/${branch}/${href.replace(/^\.?\//, '')}`;
      const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
      return `<img src="${escapeHtml(src)}" alt="${escapeHtml(text)}"${titleAttr} loading="lazy">`;
    };
    // Résout les liens relatifs vers GitHub.
    renderer.link = ({ href, title, text }: Tokens.Link) => {
      const url = isAbsolute(href)
        ? href
        : `https://github.com/${owner}/${name}/blob/${branch}/${href.replace(/^\.?\//, '')}`;
      const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
      const external = /^https?:/i.test(url) ? ' target="_blank" rel="noopener noreferrer"' : '';
      return `<a href="${escapeHtml(url)}"${titleAttr}${external}>${text}</a>`;
    };
    return renderer;
  }

  function init() {
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>('article details');
    detailsElements.forEach((details) => {
      details.addEventListener('toggle', async function () {
        if (!details.open) return;
        const article = details.closest('article');
        const repoUrl = article instanceof HTMLElement ? article.dataset.repo : undefined;
        const preview = details.querySelector<HTMLElement>('.readme-preview-detail');
        if (!preview) return;
        const loadingText = preview.dataset.loading ?? '';
        const unavailableText = preview.dataset.unavailable ?? '';
        const errorText = preview.dataset.error ?? 'Error loading README';

        // Extraire owner et nom du dépôt depuis l'URL GitHub.
        let owner = '';
        let name = '';
        try {
          const parts = new URL(repoUrl ?? '').pathname.split('/').filter(Boolean);
          owner = parts[parts.length - 2] ?? '';
          name = parts[parts.length - 1] ?? '';
        } catch (error) {
          // URL invalide : on garde owner/name vides.
        }

        if (!owner || !name) {
          preview.innerHTML = '<p>' + escapeHtml(unavailableText) + '</p>';
          return;
        }

        preview.innerHTML = '<p>' + escapeHtml(loadingText) + '</p>';

        // raw.githubusercontent.com sert le README en texte brut et autorise
        // les requêtes cross-origin : pas d'API ni de serveur nécessaire.
        try {
          let content = '';
          let branch = BRANCHES[0];
          for (const candidate of BRANCHES) {
            for (const file of FILES) {
              const url = `https://raw.githubusercontent.com/${owner}/${name}/refs/heads/${candidate}/${file}`;
              const response = await fetch(url);
              if (response.ok) {
                content = await response.text();
                branch = candidate;
                break;
              }
            }
            if (content) break;
          }
          if (!content) {
            preview.innerHTML = '<p>' + escapeHtml(unavailableText) + '</p>';
            return;
          }
          const renderer = buildRenderer(owner, name, branch);
          preview.innerHTML = marked.parse(content, { renderer, async: false }) as string;
        } catch (error) {
          preview.innerHTML = '<p>' + escapeHtml(errorText) + '</p>';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .detail {
    padding-block: var(--space-8);
    max-width: 820px;
  }
  .crumbs {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-5);
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .title h1 {
    margin: 0;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-muted);
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .en {
    margin-inline-start: 0.4rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.25rem;
    vertical-align: middle;
  }
  .untranslated {
    margin-top: var(--space-2);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .improve {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-5) 0;
  }
  .btn {
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    font-weight: 800;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .primary {
    background: var(--accent);
    color: var(--bg);
  }
  .primary:hover {
    background: var(--accent-strong);
    color: var(--bg);
  }
  .ghost {
    border-color: var(--border);
    color: var(--ink);
    background: var(--surface);
  }
  .warning {
    background: var(--warn-soft);
    color: var(--warn);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-weight: 700;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    font-weight: 800;
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 700;
  }
  .readme-preview-detail {
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-height: 480px;
    overflow: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .readme-preview-detail :global(p) {
    margin: 0.7em 0;
  }
  .readme-preview-detail :global(p:first-child),
  .readme-preview-detail :global(h1:first-child),
  .readme-preview-detail :global(h2:first-child),
  .readme-preview-detail :global(h3:first-child) {
    margin-top: 0;
  }
  .readme-preview-detail :global(h1),
  .readme-preview-detail :global(h2),
  .readme-preview-detail :global(h3),
  .readme-preview-detail :global(h4) {
    margin: 1.1em 0 0.4em;
    line-height: 1.25;
  }
  .readme-preview-detail :global(h1) {
    font-size: 1.35rem;
  }
  .readme-preview-detail :global(h2) {
    font-size: 1.18rem;
  }
  .readme-preview-detail :global(h3) {
    font-size: 1.02rem;
  }
  .readme-preview-detail :global(h4) {
    font-size: 0.95rem;
  }
  .readme-preview-detail :global(ul),
  .readme-preview-detail :global(ol) {
    margin: 0.7em 0;
    padding-inline-start: 1.5em;
  }
  .readme-preview-detail :global(li) {
    margin: 0.25em 0;
  }
  .readme-preview-detail :global(a) {
    color: var(--accent-strong);
  }
  .readme-preview-detail :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
  .readme-preview-detail :global(code) {
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.88em;
  }
  .readme-preview-detail :global(pre) {
    background: var(--surface);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    overflow: auto;
  }
  .readme-preview-detail :global(pre code) {
    background: none;
    padding: 0;
  }
  .readme-preview-detail :global(blockquote) {
    margin: 0.8em 0;
    padding-inline-start: var(--space-3);
    border-inline-start: 3px solid var(--border);
    color: var(--ink-muted);
  }
  .readme-preview-detail :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 0.8em 0;
    font-size: 0.85rem;
  }
  .readme-preview-detail :global(th),
  .readme-preview-detail :global(td) {
    border: 1px solid var(--border);
    padding: 0.35em 0.55em;
    text-align: start;
  }
  .readme-preview-detail :global(th) {
    background: var(--surface);
  }
  .readme-preview-detail :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.2em 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }
  .tags a {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
  }
  .tags a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }
  .replaced {
    color: var(--danger);
    font-weight: 700;
  }
  .related {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .related a {
    font-weight: 800;
  }
  .related .desc {
    display: block;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>
