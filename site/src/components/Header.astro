---
import { t } from '../i18n';
import { localePath, type Lang } from '../lib/routes';

interface Props {
  lang: Lang;
  path: string;
  altUrl: string;
}
const { lang, path, altUrl } = Astro.props;
const links = [
  { href: '/projects/', label: 'nav.projects' as const },
  { href: '/myo/', label: 'nav.myo' as const },
  { href: '/services/', label: 'nav.services' as const },
];

/** Outils intégrés au portail, accessibles depuis le menu « Outils ». */
const toolsLinks = [
  { href: localePath(lang, '/chooser/'), label: t(lang, 'nav.chooser'), prefix: '/chooser/' },
  { href: localePath(lang, '/editor/'), label: t(lang, 'nav.editor'), prefix: '/editor/' },
];
const toolsLabel = t(lang, 'nav.tools');

/** Liens partagés par tous les sites de la communauté Yoto. */
const contributeLink = {
  href: localePath(lang, '/contribute/'),
  label: t(lang, 'nav.contribute'),
  prefix: '/contribute/',
};
const ecosystemLinks = [
  {
    href: 'https://yoto-community.github.io/podcast-catalogue/',
    label: t(lang, 'nav.podcasts'),
  },
  {
    href: 'https://yoto-community.github.io/icons-catalogue/',
    label: t(lang, 'nav.icons'),
  },
];
const githubLink = {
  href: 'https://github.com/yoto-community/yoto-community.github.io',
  label: t(lang, 'nav.github'),
};
const navLabel = lang === 'fr' ? 'Navigation principale' : 'Main navigation';
const communityLabel = t(lang, 'nav.community');
const newTabLabel = t(lang, 'nav.newTab');
---

<header class="site-header" data-pagefind-ignore>
  <div class="container bar">
    <a class="brand" href={localePath(lang, '/')} aria-label={t(lang, 'site.title')}>
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
        <rect x="2" y="2" width="30" height="30" rx="10" fill="var(--accent)"></rect>
        <path
          d="M10 12v10M14 9v16M18 13v8M22 10v14M26 14v6"
          stroke="var(--bg)"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>
      <span>Awesome Yoto</span>
    </a>
    <nav class="desktop-nav" aria-label={navLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={localePath(lang, link.href)}
                aria-current={path === link.href ? 'page' : undefined}
              >
                {t(lang, link.label)}
              </a>
            </li>
          ))
        }
        <li class="nav-group">
          <details data-nav-group>
            <summary class="nav-group__summary">
              {toolsLabel}
              <svg
                class="nav-group__caret"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </summary>
            <ul class="nav-panel">
              {
                toolsLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={path === link.prefix ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        <li class="nav-group">
          <details data-nav-group>
            <summary class="nav-group__summary">
              {communityLabel}
              <svg
                class="nav-group__caret"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </summary>
            <ul class="nav-panel">
              <li>
                <a
                  href={contributeLink.href}
                  aria-current={path === contributeLink.prefix ? 'page' : undefined}
                >
                  {contributeLink.label}
                </a>
              </li>
              <li class="nav-panel__separator" aria-hidden="true"></li>
              {
                ecosystemLinks.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <span class="nav-panel__external-mark" aria-hidden="true">
                        ↗
                      </span>
                      <span class="sr-only">{newTabLabel}</span>
                    </a>
                  </li>
                ))
              }
              <li class="nav-panel__separator" aria-hidden="true"></li>
              <li>
                <a href={githubLink.href} target="_blank" rel="noopener noreferrer">
                  {githubLink.label}
                  <span class="nav-panel__external-mark" aria-hidden="true">
                    ↗
                  </span>
                  <span class="sr-only">{newTabLabel}</span>
                </a>
              </li>
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label={navLabel}>
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={localePath(lang, link.href)}
                  aria-current={path === link.href ? 'page' : undefined}
                >
                  {t(lang, link.label)}
                </a>
              </li>
            ))
          }
          <li class="mobile-group">
            <span class="mobile-group__label">{toolsLabel}</span>
            <ul>
              {
                toolsLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={path === link.prefix ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="mobile-group">
            <span class="mobile-group__label">{communityLabel}</span>
            <ul>
              <li>
                <a
                  href={contributeLink.href}
                  aria-current={path === contributeLink.prefix ? 'page' : undefined}
                >
                  {contributeLink.label}
                </a>
              </li>
              {
                ecosystemLinks.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <span class="nav-panel__external-mark" aria-hidden="true">
                        ↗
                      </span>
                      <span class="sr-only">{newTabLabel}</span>
                    </a>
                  </li>
                ))
              }
              <li>
                <a href={githubLink.href} target="_blank" rel="noopener noreferrer">
                  {githubLink.label}
                  <span class="nav-panel__external-mark" aria-hidden="true">
                    ↗
                  </span>
                  <span class="sr-only">{newTabLabel}</span>
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </details>
    <a
      class="lang"
      href={altUrl}
      hreflang={lang === 'en' ? 'fr' : 'en'}
      data-locale-switch={lang === 'en' ? 'fr' : 'en'}
      aria-label={lang === 'en' ? 'Version française' : 'English version'}
    >
      {lang === 'en' ? 'FR' : 'EN'}
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.1rem;
    white-space: nowrap;
  }
  .desktop-nav {
    margin-inline-start: auto;
  }
  .desktop-nav > ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a,
  .nav-group__summary {
    color: var(--ink-muted);
    text-decoration: none;
    font-weight: 700;
  }
  .desktop-nav a[aria-current='page'],
  .desktop-nav a:hover,
  .nav-group__summary:hover,
  .nav-group[open] > .nav-group__summary {
    color: var(--accent);
  }
  .nav-group {
    position: relative;
  }
  .nav-group__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nav-group__summary::-webkit-details-marker {
    display: none;
  }
  .nav-group__caret {
    flex: none;
    transition: transform 0.2s ease;
  }
  .nav-group[open] > .nav-group__summary .nav-group__caret {
    transform: rotate(180deg);
  }
  .nav-panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + var(--space-2));
    z-index: 30;
    min-width: max-content;
    margin: 0;
    padding: var(--space-2);
    display: grid;
    gap: 2px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .nav-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-panel a:hover,
  .nav-panel a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--accent);
  }
  .nav-panel__separator {
    margin: var(--space-1) 0;
    border-top: 1px solid var(--border);
  }
  .nav-panel__external-mark {
    color: var(--ink-muted);
    font-size: 0.85em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .mobile-menu {
    display: none;
    position: relative;
    margin-inline-start: auto;
  }
  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.8rem;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu[open] summary {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mobile-menu nav {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + var(--space-2));
    min-width: 12rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: var(--space-2);
    z-index: 30;
  }
  .mobile-menu ul {
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .mobile-menu a[aria-current='page'],
  .mobile-menu a:hover {
    background: var(--surface-2);
    color: var(--accent);
  }
  .mobile-group {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }
  .mobile-group__label {
    display: block;
    padding: 0.25rem 0.65rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .lang {
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.8rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .bar {
      gap: var(--space-3);
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (max-width: 380px) {
    .brand span {
      font-size: 1rem;
    }
  }
</style>
