# GitHub Packages hosts the @yoto-community/* packages.
#
# Authentication deliberately stays out of the repository. Locally, add the
# registry-scoped token once to your user config (~/.npmrc). A bare
# `_authToken=` is ignored for this registry — the key must carry the host:
#
#   echo "//npm.pkg.github.com/:_authToken=$GITHUB_TOKEN" >> ~/.npmrc
#
# The token only needs `read:packages`. CI authenticates through
# actions/setup-node (`registry-url` + `scope`), which writes an authenticated
# npmrc in the runner temp dir; no token line belongs here.
@yoto-community:registry=https://npm.pkg.github.com
