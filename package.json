{
  "name": "awesome-yoto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "build:data": "tsx scripts/build.ts",
    "build": "pnpm build:data && pnpm --filter site build && tsx scripts/postbuild.ts && pagefind --site site/dist",
    "dev": "pnpm build:data && pnpm --filter site dev",
    "check:readme": "tsx scripts/build.ts --check",
    "check:fr": "tsx scripts/check-translations.ts",
    "check": "pnpm validate && pnpm check:fr && pnpm check:readme && pnpm build:data && pnpm --filter site check && pnpm check:types",
    "check:build": "tsx scripts/check-search.ts",
    "check:i18n": "tsx scripts/check-i18n-routes.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "check:internal-links": "tsx scripts/check-internal-links.ts",
    "check:types": "tsc --noEmit",
    "verify": "pnpm check && pnpm build && pnpm check:build && pnpm check:i18n && pnpm check:budget && pnpm check:internal-links",
    "test": "vitest run",
    "og": "tsx scripts/og.ts",
    "enrich": "tsx scripts/enrich.ts",
    "check:links": "tsx scripts/check-links.ts",
    "lint:awesome": "awesome-lint README.md"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "awesome-lint": "^2.3.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
